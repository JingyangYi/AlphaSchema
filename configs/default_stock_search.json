    "path": "../data/stock_bars",
    "layout": "one_file_per_symbol",
    "date_column": "date",
    "symbol_column": "symbol",
    "start_date": null,
    "end_date": null,
    "columns": {
      "open": "open",
      "high": "high",
      "low": "low",
      "close": "close",
      "volume": "volume",
      "amount": "amount",
      "vwap": "vwap"
    }
  },
  "evaluation": {
    "forward_horizon": 5,
    "min_assets": 20,
    "reward": {
      "alpha": 10.0,
      "beta": 1.0,
      "lag1_penalty": 2.0
