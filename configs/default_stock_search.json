        "max_observations": 300,
        "explore": 8,
        "exploit": 6,
        "mutate": 2
      },
      {
        "name": "normal_reward",
        "min_observations": 300,
        "max_observations": 700,
        "explore": 5,
        "exploit": 8,
        "mutate": 3
      },
      {
        "name": "exploit_majority",
        "min_observations": 700,
        "max_observations": null,
        "explore": 3,
        "exploit": 8,
        "mutate": 5
      }
    ],
    "mutation_weights": {
      "replace_quality": 0.22,
      "replace_context": 0.16,
      "replace_output": 0.16,
      "add_quality": 0.14,
