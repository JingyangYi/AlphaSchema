{
  "run_name": "default_stock_search",
  "batch_size": 16,
  "candidate_pool_size": 10000,
  "seed": 2026062301,
  "schema_dir": "../schemas/stock_alpha",
  "artifact_dir": "../artifacts/default_stock_search",
  "periods": [20, 80],
  "max_repairs": 1,
  "data": {
